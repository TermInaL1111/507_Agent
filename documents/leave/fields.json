{
  "display_name": "请假条",
  "required": ["name", "student_id", "class_name", "reason", "start_date", "end_date"],
  "optional": ["teacher_name", "course_name", "recipient_type", "duration_days", "start_time", "end_time", "student_phone", "parent_phone", "signature", "sign_date"],
  "auto_fill": ["name", "student_id", "class_name"],
  "variants": {
    "course_leave": {
      "label": "课程请假",
      "required": ["recipient_type"],
      "optional": ["teacher_name", "course_name", "start_time", "end_time"],
      "formal_required": ["duration_days", "start_time", "end_time", "student_phone", "parent_phone"],
      "auto_detect_from_schedule": true,
      "sub_variants": {
        "teacher": {
          "label": "交给任课老师",
          "formal_required": ["teacher_name"],
          "template": "template_course_teacher.docx"
        },
        "student_affairs": {
          "label": "学工组备案",
          "formal_required": [],
          "template": "template_course_affairs.docx"
        }
      },
      "default_recipient_type": "teacher"
    },
    "long_leave": {
      "label": "长假期请假",
      "required": [],
      "optional": ["destination", "relative_relation", "relative_phone", "phone", "leave_start", "leave_end", "total_days"],
      "template": "template_long.docx"
    }
  }
}
