# FastAPI service

# MySQL database used by chat history, source files and schedule events.
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

# Django user service base URL.
DJANGO_API_URL=http://127.0.0.1:8001

# JWT settings. Keep SECRET_KEY consistent with the Django user service if both services validate the same token.
SECRET_KEY=change-me
ALGORITHM=HS256

# DashScope / Aliyun model API.
ALIYUN_ACCESS_KEY_SECRET=your_dashscope_api_key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key

# Redis cache.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3

# AMap Web Service key for in-site walking route planning.
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key

# Reranker model. Set SKIP_RERANKER_DOWNLOAD=true for local startup without downloading a reranker.
SKIP_RERANKER_DOWNLOAD=true
RERANKER_MODEL_PATH=D:\Hugging_Face\models\Qwen3-Reranker-0.6B

# LangSmith tracing. Disable unless you have configured a valid key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=my-fastapi-langchain-project
