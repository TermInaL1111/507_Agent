# Copy this file to .env before running docker compose.

FRONTEND_PORT=80

# MySQL container root password.
MYSQL_ROOT_PASSWORD=change-me-root-password

# FastAPI database. Keep MYSQL_USER/MYSQL_PASSWORD consistent with the init SQL if you change them.
MYSQL_DATABASE=chat_history
MYSQL_USER=agent_user
MYSQL_PASSWORD=change-me-mysql-password

# Django database.
DJANGO_DB_NAME=django_user_service
DJANGO_DB_USER=agent_user
DJANGO_DB_PASSWORD=change-me-mysql-password

# JWT and Django secrets.
SECRET_KEY=change-me-shared-jwt-secret
ALGORITHM=HS256
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_ALLOWED_HOSTS=*

# DashScope / Aliyun model API.
ALIYUN_ACCESS_KEY_SECRET=your_dashscope_api_key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key

# Redis. In Docker these host/port values are overridden to redis:6379.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=3

# AMap.
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key
VITE_AMAP_KEY=your_amap_js_api_key
VITE_AMAP_SECURITY_CODE=your_amap_security_js_code

# Reranker.
SKIP_RERANKER_DOWNLOAD=true
RERANKER_MODEL_PATH=/opt/models/Qwen3-Reranker-0.6B

# LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=507-agent

# Campus Channel public aggregation
CAMPUS_CHANNEL_URL=https://pd.qq.com/g/px50o26u67
CAMPUS_CHANNEL_AUTO_SCRAPE=false
CAMPUS_CHANNEL_SCRAPE_INTERVAL_MINUTES=360
CAMPUS_CHANNEL_AUTO_SYNC_RAG=false
CAMPUS_CHANNEL_MAX_POSTS_PER_RUN=50
CAMPUS_CHANNEL_INCLUDE_IMAGES=false
CAMPUS_CHANNEL_USER_AGENT=Mozilla/5.0 (compatible; 507-Agent-CampusChannel/1.0; public-page-fetch)
CAMPUS_CHANNEL_USE_PLAYWRIGHT=auto
CAMPUS_CHANNEL_HEADLESS=true
CAMPUS_CHANNEL_PLAYWRIGHT_SCROLLS=8
CAMPUS_CHANNEL_PLAYWRIGHT_WAIT_MS=900
CAMPUS_CHANNEL_SECTION_SCAN_LIMIT=20
CAMPUS_CHANNEL_FETCH_DETAILS=true
CAMPUS_CHANNEL_DETAIL_LIMIT=20
CAMPUS_CHANNEL_COMMENT_DETAIL_LIMIT=5

